# Optional. Required only for `northline-eval --mode live` and the OpenAI generator.
OPENAI_API_KEY=

# Optional. memory (default) uses FAISS. pgvector uses the compose Postgres service.
NORTHLINE_RETRIEVER=memory
NORTHLINE_DATABASE_URL=postgresql://northline:northline@localhost:5432/northline

# hashing (default) or openai. openai also requires OPENAI_API_KEY.
NORTHLINE_EMBEDDINGS=hashing
